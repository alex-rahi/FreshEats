aws_region  = "us-east-1"
environment = "prod"
name        = "fresheats"

# Monthly budget (USD) — sized for lean EKS+NAT demo (~$200–250 steady state)
budget_limit_usd = 250
budget_alert_emails = [
  # "you@example.com"
]

# Progressive spend control (stay under shutoff):
# 50% soft scale → desired=1
# 70% hard lock → desired=1, max=1
# 80% shutoff
# alert_threshold   = 50
# scale_threshold   = 70
# shutoff_threshold = 80

# Test shutoff safely first (plan-only Lambda; no mutations)
# cost_guardrails_dry_run = true
