# Auth / mode
AUTH_PROVIDER=placeholder
USE_PLACEHOLDERS=true
USE_LOCAL_YOLO=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Backend
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
WORKER_URL=http://localhost:8001
UPLOADS_DIR=data/uploads
ADMIN_SECRET=placeholder-admin-secret

# AWS (set when AUTH_PROVIDER=cognito)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
STORAGE_BUCKET_RAW=fresheats-raw-uploads
STORAGE_BUCKET_RECIPES=fresheats-recipe-images
CLOUDFRONT_DOMAIN=
SQS_MODERATION_URL=
REDIS_URL=

# AI Worker
YOLO_MODEL_PATH=workers/models/yolov8n.pt
MODERATION_THRESHOLD=0.7

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_USE_PLACEHOLDERS=true
EXPO_PUBLIC_USE_LOCAL_YOLO=false
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_CDN_URL=

# Admin dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_SECRET=placeholder-admin-secret
